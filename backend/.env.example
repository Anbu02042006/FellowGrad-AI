# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated allowed origins or single origin
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://10.0.2.2:8081,http://localhost:8080

# JWT Security
# 64-character hex key matching Spring Boot HS256 key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_REFRESH_SECRET=736A586E3272357538782F413F4428472B4B6250645367566B5970404E635266
JWT_EXPIRATION=86400000
PASSWORD_SALT_ROUNDS=10

# PostgreSQL Database (Auth & User profiles)
DATABASE_URL=postgres://postgres:admin@localhost:5432/fellowgrad_auth
PG_USER_DB_URL=postgres://postgres:password@localhost:5432/fellowgrad_user
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin
PGDATABASE=fellowgrad_auth

# MongoDB Database (Conversations & Messages)
MONGODB_URI=mongodb://localhost:27017/fellowgrad_conversations

# Google Cloud / Vertex AI (Gemini Live API)
# Production: Uses Cloud Run service account fellowgrad-backend@fellowgrad-ai.iam.gserviceaccount.com
# Local: Authenticate via `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=fellowgrad-ai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_VOICE_NAME=Aoede

# Google Gemini AI (Legacy REST / Text fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/

# Legacy Voice Providers (Deprecated - ElevenLabs / Google STT REST)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Nda4CxqYPMJ65wadFnhJ
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

